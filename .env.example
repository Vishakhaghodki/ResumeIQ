# Copy this file to .env and fill in values. NEVER commit .env.
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=1
PORT=5000

# AI provider: auto | anthropic | openai | demo
# "auto" uses whichever API key is set; with no key it runs in demo mode.
AI_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Works with any OpenAI-compatible endpoint (Groq, Together, local servers...)
OPENAI_BASE_URL=https://api.openai.com/v1
